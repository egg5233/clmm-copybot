# ===== 必填 =====

# 機器人錢包私鑰 (base58 格式)
PRIVATE_KEY=<你的base58私鑰>

# Solana RPC (需支援 WebSocket，推薦 Helius 免費方案)
# Helius 用於 WebSocket 監控 + 送交易
RPC_URL=https://mainnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>
WS_URL=wss://mainnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>

# 監控目標錢包 (逗號分隔，可填多個)
TARGET_WALLETS=<目標錢包地址1>,<目標錢包地址2>

# ===== 選填 =====

# Alchemy RPC (用於讀取餘額/查詢交易，避免 Helius indexing 延遲)
# 不設定則全部使用 Helius
ALCHEMY_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>

# 僅關倉錢包 (逗號分隔，不須在 TARGET_WALLETS 中，會自動訂閱監控)
# 這些錢包只複製「關倉/減少流動性/交換」，忽略開倉和加倉
CLOSE_ONLY_WALLETS=

# 金額比例 (1.0 = 100% 鏡像，0.5 = 50%)
AMOUNT_RATIO=1.0

# 滑點容忍 (基點，100 = 1%)
SLIPPAGE_BPS=100

# 交易失敗重試次數
MAX_RETRY=3

# Priority Fee (microLamports)
PRIORITY_FEE_LAMPORTS=50000

# Byreal Program ID (通常不需要改)
BYREAL_PROGRAM_ID=REALQqNEomY6cQGZJUGwywTBD2UmDT32rZcNnfxQ5N2

# 模擬模式 (true = 不實際交易，只記錄日誌)
DRY_RUN=false

# Byreal 允許同 tick 來源錢包，逗號分隔；這些錢包開出的 referer 不阻止其他錢包跟同倉
BYREAL_ALLOW_SAME_TICK_WALLETS=
# Byreal allow same tick direction: selected wallets may open after positions opened by others
BYREAL_ALLOW_OPEN_AFTER_OTHERS_WALLETS=
# Byreal active position cap. 0 = disabled; 415 blocks opening position 416.
BYREAL_MAX_OPEN_POSITIONS=0
# Byreal minimum pool age in days. 0 = disabled.
MIN_POOL_AGE_DAYS=0
# Token mint whitelist for bypassing only the minimum pool age check.
POOL_AGE_WHITELIST=

# ===== DAC (Daily Auto-Convert to BTC) =====
DAC_ENABLED=false
DAC_AMOUNT_USD=10
DAC_THRESHOLD_MULTIPLIER=1
DAC_EXECUTE_HOUR=0
DAC_EXECUTE_MINUTE=0
DAC_TARGET_TOKEN=cbbtc
DAC_TRANSFER_TO=

# ===== 中控台 (Dashboard) =====

# 中控台密碼 (設定後啟用 Web 中控台，不設定則停用)
DASHBOARD_PASSWORD=<設定一組強密碼>

# 中控台 Port (預設 3847)
DASHBOARD_PORT=3847
