# Signer Service Environment Variables
# Private key is NOT stored here — it's encrypted in keyfile.enc.json
# Run: npx ts-node setup.ts   (one-time, to encrypt your key)

# RPC URL — signer uses its own RPC (not shared with bot)
SIGNER_RPC_URL=https://api.mainnet-beta.solana.com

# Unix socket path (must match SIGNER_SOCKET_PATH in bot's .env)
SIGNER_SOCKET_PATH=/tmp/byreal-signer.sock

# Unlock page — enter password via browser instead of terminal
# Set to 0 to disable (stdin only)
SIGNER_UNLOCK_PORT=3848
SIGNER_UNLOCK_IP=127.0.0.1

# Whitelisted transfer destinations (comma-separated)
# e.g. your cold wallet, DAC transfer target
SIGNER_DEST_WHITELIST=

# Log level: debug | info | warn | error
SIGNER_LOG_LEVEL=info
